{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear",
        "hooks": [ { "type": "command", "command": "python3 bin/team_sync.py start", "timeout": 60 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 bin/team_sync.py stop", "timeout": 120 } ] }
    ]
  }
}
