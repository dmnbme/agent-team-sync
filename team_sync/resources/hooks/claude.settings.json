{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f bin/team_sync.py ] && python3 bin/team_sync.py start || true",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/bin/team_sync.py\" ] && python3 \"$d/bin/team_sync.py\" hook claude prompt || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f bin/team_sync.py ] && python3 bin/team_sync.py stop --session-end || true",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/bin/team_sync.py\" ] && python3 \"$d/bin/team_sync.py\" hook claude stop || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
