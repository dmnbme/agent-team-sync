{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f bin/team_sync.py ] && python3 bin/team_sync.py start || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f bin/team_sync.py ] && python3 bin/team_sync.py stop || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
